<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <ImageView
        android:id="@+id/banner"
        android:layout_width="0dp"
        android:layout_height="77dp"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/qld_health"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/black"/>

        <Space android:layout_width="8dp" android:layout_height="0dp"/>

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Edit"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/black"/>

        <Space android:layout_width="8dp" android:layout_height="0dp"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Delete"
            android:textSize="12sp"
            android:backgroundTint="#E57373"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/fieldTradingName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trading Name:"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/fieldStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status:"
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F2F4F7"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/fieldLGA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LGA Name:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name/s:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldLicence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Licence Number:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldRegistration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registration:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiry Date:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle:"
                    android:textColor="@android:color/black" />

                <Space android:layout_width="0dp" android:layout_height="8dp"/>

                <TextView
                    android:id="@+id/fieldDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description:"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/fieldMake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Make:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldColour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colour:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldOther1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other distinguishing features:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldPrimaryLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary location of vending machine:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldSerial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Serial number / identification number / mark:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/fieldOther2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other distinguishing features:"
                    android:textColor="@android:color/black"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
