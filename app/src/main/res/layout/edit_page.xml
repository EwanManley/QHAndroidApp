<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etLga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="LGA Name"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name/s"/>

        <EditText
            android:id="@+id/etTrading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Trading name"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone"/>

        <EditText
            android:id="@+id/etLicence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Licence number"/>

        <EditText
            android:id="@+id/etExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date (YYYY-MM-DD)"/>

        <EditText
            android:id="@+id/etReg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Registration number"/>

        <EditText
            android:id="@+id/etStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Status (Active / Suspended / etc.)"/>

        <EditText
            android:id="@+id/etDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description of the food business"/>

        <EditText
            android:id="@+id/etVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type of vehicle"/>

        <EditText
            android:id="@+id/etMake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Make"/>

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model"/>

        <EditText
            android:id="@+id/etColour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Colour"/>

        <EditText
            android:id="@+id/etPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Primary location of vending machine"/>

        <EditText
            android:id="@+id/etSerial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Serial number / identification / mark"/>

        <EditText
            android:id="@+id/etOther1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Other distinguishing features"/>

        <EditText
            android:id="@+id/etOther2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Other distinguishing features 2 (if applicable)"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"/>

            <Space
                android:layout_width="8dp"
                android:layout_height="0dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:backgroundTint="#2196F3"
                android:textColor="@android:color/black"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
